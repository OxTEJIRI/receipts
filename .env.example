# Copy to .env.local and fill in. Never commit .env.local.

# Zetaris (UI proxy route, same as zetaris/getting-started scripts)
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
# Either an API key (Management -> API Tokens) ...
ZETARIS_API_KEY=
# ... or a username and password
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_QUERY_LIMIT=1000
ZETARIS_ENGINE_ID=

# NVIDIA (build.nvidia.com), OpenAI-compatible endpoint
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Where H-MEM keeps state.json and ledger.jsonl
HMEM_DIR=data/memory
